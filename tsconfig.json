{
    "compilerOptions": {
        /* Базовые настройки */
        "target": "es2021", /* Современный JS для Webpack */
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ], /* Поддержка браузерного API и новых фич */
        "jsx": "react-jsx", /* Современный режим React (не требует import React from 'react') */
        /* Модули и Импорты (Решает проблемы с путями) */
        "module": "esnext", /* Webpack сам отлично управляет ES-модулями */
        "moduleResolution": "bundler", /* Идеально для Webpack: разрешает импорты БЕЗ указания .tsx/.ts */
        "allowImportingTsExtensions": false, /* Запрещает писать расширения .ts в импортах */
        "resolveJsonModule": true, /* Позволяет импортировать .json файлы */
        "allowJs": true, /* Позволяет использовать JS файлы рядом с TS */
        "esModuleInterop": true, /* Правильный импорт CJS модулей (например, import React) */
        "allowSyntheticDefaultImports": true, /* Позволяет дефолтные импорты без явного default экспорта */
        /* Строгие проверки (Рекомендуется для стабильности) */
        "strict": true, /* Включает все проверки, strictNullChecks и noImplicitAny */
        "noImplicitThis": true,
        "strictNullChecks": false,
        /* Сборка */
        "sourceMap": true, /* Карты кода для дебага в браузере */
        "noEmit": true, /* Webpack (через ts-loader/babel) сам соберет JS, TS только проверяет типы */
        "isolatedModules": true, /* Гарантирует, что Webpack безопасно транспилирует каждый файл отдельно */
        "skipLibCheck": true /* Не проверяет типы внутри node_modules (ускоряет сборку в разы) */
    },
    "include": [
        "src/**/*"
    ], /* Проверяем только вашу папку с исходным кодом */
    "exclude": [
        "node_modules",
        "dist",
        "build"
    ]
}